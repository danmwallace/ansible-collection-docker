# Arcane Docker Compose Configuration
# Generated at 2/8/2026, 11:52:46 PM

services:
  socket-proxy:
    image: ghcr.io/tecnativa/docker-socket-proxy:{{ arcane_socket_proxy_version }}
    container_name: arcane-socket-proxy
    restart: unless-stopped
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
    environment:
      - CONTAINERS=1
      - IMAGES=1
      - NETWORKS=1
      - VOLUMES=1
      - SERVICES=1
      - TASKS=1
      - INFO=1
      - VERSION=1
      - POST=1
      - BUILD=0
      - AUTH=0
      - SECRETS=0
      - SWARM=0
    networks:
      - arcane_socket_net

  arcane:
    # Arcane 3.x dropped the GHCR-only `arcane` alias; the image is `manager`.
    image: ghcr.io/getarcaneapp/manager:{{ arcane_version }}
    container_name: arcane
    restart: unless-stopped
    # No published port: Traefik reaches Arcane over proxy_network (#61).
    volumes:
      - arcane-data:/app/data
    # Arcane 3.x reads only ARCANE_-prefixed names and refuses to start if an
    # unprefixed 2.x name is set. PUID, PGID and DOCKER_HOST are standard names
    # and keep theirs. Arcane reads its DB credentials from ARCANE_DATABASE_URL;
    # the POSTGRES_* names belong to the arcane-postgres service only.
    environment:
      - ARCANE_APP_URL=https://{{ arcane_hostname }}
      - PUID=1000
      - PGID=1000
      - ARCANE_ENCRYPTION_KEY={{ arcane_encryption_key }}
      - ARCANE_LOG_LEVEL=info
      - ARCANE_LOG_JSON=false
      - ARCANE_DATABASE_URL={{ arcane_database_url }}
      - DOCKER_HOST=tcp://socket-proxy:2375
    depends_on:
      - arcane-postgres
      - socket-proxy
    networks:
      - arcane_network
      - proxy_network
      - arcane_socket_net
    labels:
      - "traefik.enable=true"
      - "traefik.docker.network=proxy_network"
      - "traefik.http.routers.arcane.rule=Host(`{{ arcane_hostname }}`)"
      - "traefik.http.routers.arcane.entrypoints=websecure"
      - "traefik.http.routers.arcane.tls.certresolver=cloudflare"
      - "traefik.http.services.arcane.loadbalancer.server.port=3552"

  arcane-postgres:
    image: postgres:{{ arcane_postgres_version }}
    container_name: arcane-postgres
    restart: unless-stopped
    environment:
      - POSTGRES_DB={{ arcane_postgres_db }}
      - POSTGRES_USER={{ arcane_postgres_user }}
      - POSTGRES_PASSWORD={{ arcane_postgres_password }}
    volumes:
      - postgres-data:/var/lib/postgresql/data
    # No published port: Arcane reaches Postgres over arcane_network (#54).
    networks:
      - arcane_network

volumes:
  arcane-data:
    driver: local
  postgres-data:
    driver: local

networks:
  arcane_network:
    driver: "bridge"
  arcane_socket_net:
    driver: bridge
    internal: true
  proxy_network:
    external: true
    name: proxy_network
